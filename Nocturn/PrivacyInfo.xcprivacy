<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Nocturn collects nothing and tracks nobody: the only network traffic is
	     to the Hermes host the user configures in Settings. The one entry below
	     is required because ConnectionSettings reads/writes UserDefaults, which
	     Apple classifies as a "required reason" API. Without this manifest the
	     App Store upload returns ITMS-91053 (missing API declaration). -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: access info from the app itself, same app only. -->
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
